{% extends 'layouts/admin.twig' %}
{% block title %}Listen{% endblock %}
{% block content %}
<section class="card app-card">
    <div class="card-body p-4">
        <h1 class="h2 mb-3">Listenausgabe</h1>
        <p>PDF-Teilnehmerlisten (Name, E-Mail) je Schiene.</p>

        {% if fachbereiche is empty %}
            <p class="mb-0">Keine Fachbereiche vorhanden.</p>
        {% else %}
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr><th>Fachbereich</th><th>Schiene</th><th>Anmeldungen</th><th></th></tr>
                    </thead>
                    <tbody>
                    {% for fb in fachbereiche %}
                        {% if fb.schienen is empty %}
                            <tr>
                                <td>{{ fb.name }}</td>
                                <td colspan="2" class="text-muted">Keine Schienen</td>
                                <td></td>
                            </tr>
                        {% else %}
                            {% for s in fb.schienen %}
                                <tr>
                                    {% if loop.first %}
                                        <td rowspan="{{ fb.schienen|length }}">{{ fb.name }}</td>
                                    {% endif %}
                                    <td>{{ s.name }}</td>
                                    <td>{{ s.belegt }}</td>
                                    <td>
                                        <a class="btn btn-outline-primary btn-sm"
                                           href="/administrator/listen/{{ fb.id }}/schiene/{{ s.id }}.pdf">
                                            PDF herunterladen
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
