{% extends 'layouts/admin.twig' %}
{% block title %}Fachbereiche{% endblock %}
{% block content %}
<section class="panel">
    <div class="panel-head">
        <h1>Fachbereiche</h1>
        <a class="btn" href="/administrator/fachbereiche/neu">Neu anlegen</a>
    </div>
    {% if flash %}<p class="flash">{{ flash }}</p>{% endif %}

    {% if fachbereiche is empty %}
        <p>Noch keine Fachbereiche vorhanden.</p>
    {% else %}
        <table class="data-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Schienen</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            {% for fb in fachbereiche %}
                <tr>
                    <td>{{ fb.name }}</td>
                    <td>{% if fb.aktiv %}aktiv{% else %}inaktiv{% endif %}</td>
                    <td>{{ fb.schienen|length }}</td>
                    <td class="actions-cell">
                        <a href="/administrator/fachbereiche/{{ fb.id }}">Bearbeiten</a>
                        <form method="post" action="/administrator/fachbereiche/{{ fb.id }}/toggle" class="inline-form">
                            {{ csrf.field()|raw }}
                            <button type="submit" class="linkish">{% if fb.aktiv %}Deaktivieren{% else %}Aktivieren{% endif %}</button>
                        </form>
                        <form method="post" action="/administrator/fachbereiche/{{ fb.id }}/delete" class="inline-form" onsubmit="return confirm('Wirklich löschen?');">
                            {{ csrf.field()|raw }}
                            <button type="submit" class="linkish danger">Löschen</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
</section>
{% endblock %}
