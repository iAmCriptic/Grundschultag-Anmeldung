{% extends 'layouts/admin.twig' %}
{% block title %}{% if fachbereich and fachbereich.id %}Fachbereich bearbeiten{% else %}Neuer Fachbereich{% endif %}{% endblock %}
{% block content %}
<p class="mb-3">
    <a class="btn btn-outline-primary" href="/administrator/fachbereiche">← Zurück</a>
</p>

<section class="card app-card mb-4">
    <div class="card-body p-4">
        <h1 class="h2 mb-3">{% if fachbereich and fachbereich.id %}Fachbereich bearbeiten{% else %}Neuer Fachbereich{% endif %}</h1>
        {% if flash %}<div class="alert alert-success">{{ flash }}</div>{% endif %}
        {% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}

        <form method="post"
              action="{% if fachbereich and fachbereich.id %}/administrator/fachbereiche/{{ fachbereich.id }}{% else %}/administrator/fachbereiche{% endif %}"
              enctype="multipart/form-data"
              {% if fachbereich and fachbereich.id %}data-autosave{% endif %}>
            {{ csrf.field()|raw }}
            <div class="mb-3">
                <label class="form-label" for="name">Name</label>
                <input class="form-control" type="text" name="name" id="name" required value="{{ fachbereich.name|default('') }}">
            </div>
            <div class="mb-3">
                <label class="form-label" for="email">
                    E-Mail Fachbereich
                    {% include 'partials/settings_info.twig' with { text: 'Optional. Wird für Listenversand und Mitadressierung bei Rundmails genutzt.' } %}
                </label>
                <input class="form-control" type="email" name="email" id="email"
                       value="{{ fachbereich.email|default('') }}"
                       placeholder="z. B. fachbereich@schule.de">
            </div>
            <div class="mb-3">
                <label class="form-label" for="teaser_text">Teaser-Text</label>
                <textarea class="form-control rich-editor" name="teaser_text" id="teaser_text" rows="5">{{ fachbereich.teaser_text|default('') }}</textarea>
            </div>
            <div class="mb-3">
                <label class="form-label" for="teaser_bild">Teaser-Bild</label>
                <input class="form-control" type="file" name="teaser_bild" id="teaser_bild" accept="image/jpeg,image/png,image/webp,image/gif">
            </div>
            {% if fachbereich.teaser_bild|default('') %}
                <p><img class="thumb" src="/uploads/{{ fachbereich.teaser_bild }}" alt=""></p>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="remove_image" value="1" id="remove_image">
                    <label class="form-check-label" for="remove_image">Bild entfernen</label>
                </div>
            {% endif %}
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="aktiv" value="1" id="aktiv" {% if fachbereich is null or fachbereich.aktiv|default(1) %}checked{% endif %}>
                <label class="form-check-label" for="aktiv">Aktiv</label>
            </div>
            <button type="submit" class="btn btn-primary">Speichern</button>
        </form>
    </div>
</section>

{% if fachbereich and fachbereich.id %}
<section class="card app-card">
    <div class="card-body p-4">
        <h2 class="h4 mb-3">Schienen</h2>
        {% if schienen is empty %}
            <p>Noch keine Schienen. Legen Sie mindestens eine an.</p>
        {% else %}
            <p class="text-muted small mb-3">Reihenfolge per Drag &amp; Drop ändern.</p>
            <div id="schienen-list" class="schienen-list" data-reorder-url="/administrator/fachbereiche/{{ fachbereich.id }}/schienen/reorder" data-csrf="{{ csrf.token() }}">
                {% for s in schienen %}
                    <div class="schiene-row" data-id="{{ s.id }}">
                        <button type="button" class="schiene-drag" title="Ziehen zum Sortieren" aria-label="Ziehen zum Sortieren" draggable="true">⋮⋮</button>
                        <form method="post" action="/administrator/fachbereiche/{{ fachbereich.id }}/schienen/{{ s.id }}" class="schiene-edit-form row g-2 align-items-center flex-grow-1" id="schiene-edit-{{ s.id }}" data-autosave>
                            {{ csrf.field()|raw }}
                            <div class="col-md-6">
                                <input class="form-control" type="text" name="name" value="{{ s.name }}" required aria-label="Name">
                            </div>
                            <div class="col-md-3">
                                <input class="form-control" type="number" name="kapazitaet" value="{{ s.kapazitaet }}" min="1" required aria-label="Kapazität">
                            </div>
                            <div class="col-md-3 d-flex align-items-center gap-2 flex-wrap" data-autosave-status>
                                <button type="submit" class="btn btn-primary btn-sm">Speichern</button>
                                <span class="text-muted small">{{ s.belegt }}/{{ s.kapazitaet }} belegt</span>
                            </div>
                        </form>
                        <div class="schiene-actions">
                            <form method="post" action="/administrator/fachbereiche/{{ fachbereich.id }}/schienen/{{ s.id }}/delete" class="schiene-delete-form" onsubmit="return confirm('Schiene löschen?');">
                                {{ csrf.field()|raw }}
                                <button type="submit" class="btn btn-outline-danger btn-sm">Löschen</button>
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        <h3 class="h5 mt-4">Neue Schiene</h3>
        <form method="post" action="/administrator/fachbereiche/{{ fachbereich.id }}/schienen" class="row g-2 align-items-center">
            {{ csrf.field()|raw }}
            <div class="col-md-5">
                <input class="form-control" type="text" name="name" placeholder="z. B. Vormittag" required>
            </div>
            <div class="col-md-2">
                <input class="form-control" type="number" name="kapazitaet" value="20" min="1" required>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary">Hinzufügen</button>
            </div>
        </form>
    </div>
</section>
{% endif %}
{% endblock %}

{% block scripts %}
{% include 'partials/rich_editor_assets.twig' %}
{% if fachbereich and fachbereich.id and schienen is not empty %}
<script>
(function () {
    var list = document.getElementById('schienen-list');
    if (!list) return;

    var dragEl = null;
    var reorderUrl = list.getAttribute('data-reorder-url');
    var csrf = list.getAttribute('data-csrf');

    list.querySelectorAll('.schiene-row').forEach(function (row) {
        var handle = row.querySelector('.schiene-drag');
        if (!handle) return;

        handle.addEventListener('dragstart', function (e) {
            dragEl = row;
            row.classList.add('is-dragging');
            if (e.dataTransfer) {
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/plain', row.getAttribute('data-id') || '');
            }
        });
        handle.addEventListener('dragend', function () {
            row.classList.remove('is-dragging');
            list.querySelectorAll('.schiene-row').forEach(function (r) {
                r.classList.remove('drag-over');
            });
            dragEl = null;
            saveOrder(row);
        });
        row.addEventListener('dragover', function (e) {
            e.preventDefault();
            if (!dragEl || dragEl === row) return;
            row.classList.add('drag-over');
            var rect = row.getBoundingClientRect();
            var before = (e.clientY - rect.top) < rect.height / 2;
            if (before) {
                list.insertBefore(dragEl, row);
            } else {
                list.insertBefore(dragEl, row.nextSibling);
            }
        });
        row.addEventListener('dragleave', function () {
            row.classList.remove('drag-over');
        });
        row.addEventListener('drop', function (e) {
            e.preventDefault();
            row.classList.remove('drag-over');
        });
    });

    function saveOrder(anchorRow) {
        var ids = Array.prototype.map.call(list.querySelectorAll('.schiene-row'), function (row) {
            return parseInt(row.getAttribute('data-id'), 10);
        }).filter(function (id) { return id > 0; });

        var body = new URLSearchParams();
        body.set('_csrf', csrf || '');
        ids.forEach(function (id) { body.append('order[]', String(id)); });

        fetch(reorderUrl, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: body.toString(),
            credentials: 'same-origin'
        }).then(function (res) {
            return res.json().catch(function () { return { ok: false }; }).then(function (data) {
                return { res: res, data: data };
            });
        }).then(function (result) {
            if (!result.res.ok || !result.data || result.data.ok === false) {
                return;
            }
            var form = anchorRow && anchorRow.querySelector('form[data-autosave]');
            if (form && window.AdminAutosave && typeof window.AdminAutosave.showCheck === 'function') {
                window.AdminAutosave.showCheck(form, form.querySelector('[data-autosave-status]'));
            }
        }).catch(function () {
            // still usable; next page load shows previous order
        });
    }
})();
</script>
{% endif %}
{% endblock %}
