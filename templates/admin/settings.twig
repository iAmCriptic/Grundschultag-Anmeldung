{% extends 'layouts/admin.twig' %}
{% block title %}Einstellungen{% endblock %}
{% block content %}
{% set tab = active_tab|default('darstellung') %}
<section class="settings-page">
    <header class="settings-page-header">
        <h1 class="h2 mb-1">Einstellungen</h1>
        <p class="text-muted mb-0">Darstellung, Zeitraum, Benutzer, Updates und Datenverwaltung</p>
    </header>

    {% if flash %}<div class="alert alert-success mt-3 mb-0">{{ flash }}</div>{% endif %}
    {% if error %}<div class="alert alert-danger mt-3 mb-0">{{ error }}</div>{% endif %}

    <div class="settings-shell mt-4">
        <nav class="settings-nav" aria-label="Einstellungsbereiche">
            <button type="button" class="settings-nav-item{% if tab == 'darstellung' %} is-active{% endif %}" data-settings-tab="darstellung">Darstellung</button>
            <button type="button" class="settings-nav-item{% if tab == 'zeitraum' %} is-active{% endif %}" data-settings-tab="zeitraum">Zeitraum</button>
            <button type="button" class="settings-nav-item{% if tab == 'email' %} is-active{% endif %}" data-settings-tab="email">E-Mail</button>
            <button type="button" class="settings-nav-item{% if tab == 'rechtliches' %} is-active{% endif %}" data-settings-tab="rechtliches">Rechtliches</button>
            <button type="button" class="settings-nav-item{% if tab == 'benutzer' %} is-active{% endif %}" data-settings-tab="benutzer">Benutzer</button>
            <button type="button" class="settings-nav-item{% if tab == 'update' %} is-active{% endif %}" data-settings-tab="update">Update</button>
            <button type="button" class="settings-nav-item settings-nav-item-danger{% if tab == 'daten' %} is-active{% endif %}" data-settings-tab="daten">Daten</button>
        </nav>

        <div class="settings-panels">
            {# —— Darstellung / Zeitraum / E-Mail / Rechtliches —— #}
            <form method="post" action="/administrator/einstellungen" enctype="multipart/form-data" id="settings-main-form">
                {{ csrf.field()|raw }}
                <input type="hidden" name="active_tab" id="active_tab" value="{{ tab }}">

                <div class="settings-panel{% if tab == 'darstellung' %} is-active{% endif %}" data-panel="darstellung">
                    <h2 class="settings-panel-title">Darstellung</h2>
                    <p class="settings-panel-lead">Titel, Logo und Willkommensseite für die öffentliche Anmeldung.</p>

                    <div class="settings-block">
                        <h3 class="settings-block-title">Titel</h3>
                        <div class="mb-0">
                            <label class="form-label" for="site_title">Seitentitel</label>
                            <input class="form-control" type="text" name="site_title" id="site_title" maxlength="150"
                                   value="{{ settings.site_title|default(app_name, true) }}"
                                   placeholder="z. B. Merian Schule">
                            <div class="form-text">Erscheint in der Kopfzeile, im Fuß und auf der Willkommensseite.</div>
                        </div>
                    </div>

                    <div class="settings-block">
                        <h3 class="settings-block-title">Logo</h3>
                        <div class="mb-3">
                            <label class="form-label" for="site_logo">Logo oben links</label>
                            <input class="form-control" type="file" name="site_logo" id="site_logo" accept="image/jpeg,image/png,image/webp,image/gif">
                        </div>
                        {% if settings.site_logo|default('') %}
                            <div class="settings-preview mb-2">
                                <img class="thumb" src="/uploads/{{ settings.site_logo }}" alt="Aktuelles Logo">
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="remove_site_logo" value="1" id="remove_site_logo">
                                <label class="form-check-label" for="remove_site_logo">Logo entfernen</label>
                            </div>
                        {% endif %}
                    </div>

                    <div class="settings-block">
                        <h3 class="settings-block-title">Willkommensseite</h3>
                        <div class="mb-3">
                            <label class="form-label" for="welcome_text">Willkommenstext</label>
                            <textarea class="form-control rich-editor" name="welcome_text" id="welcome_text" rows="7">{{ settings.welcome_text|default('') }}</textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="welcome_image">Willkommensbild</label>
                            <input class="form-control" type="file" name="welcome_image" id="welcome_image" accept="image/jpeg,image/png,image/webp,image/gif">
                        </div>
                        {% if settings.welcome_image|default('') %}
                            <div class="settings-preview mb-2">
                                <img class="thumb" src="/uploads/{{ settings.welcome_image }}" alt="Aktuelles Willkommensbild">
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="remove_welcome_image" value="1" id="remove_welcome_image">
                                <label class="form-check-label" for="remove_welcome_image">Bild entfernen</label>
                            </div>
                        {% endif %}
                    </div>

                    <button type="submit" class="btn btn-primary">Speichern</button>
                </div>

                <div class="settings-panel{% if tab == 'zeitraum' %} is-active{% endif %}" data-panel="zeitraum">
                    <h2 class="settings-panel-title">Anmeldezeitraum</h2>
                    <p class="settings-panel-lead">Außerhalb dieses Zeitfensters ist die öffentliche Anmeldung geschlossen.</p>

                    <div class="row g-3 settings-block">
                        <div class="col-md-6">
                            <label class="form-label" for="registration_start">Start</label>
                            <input class="form-control" type="datetime-local" name="registration_start" id="registration_start" value="{{ settings.registration_start|default('')|replace({' ': 'T'})|slice(0, 16) }}">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="registration_end">Ende</label>
                            <input class="form-control" type="datetime-local" name="registration_end" id="registration_end" value="{{ settings.registration_end|default('')|replace({' ': 'T'})|slice(0, 16) }}">
                        </div>
                    </div>
                    <p class="text-muted small">Leer lassen = kein Limit.</p>
                    <button type="submit" class="btn btn-primary">Speichern</button>
                </div>

                <div class="settings-panel{% if tab == 'email' %} is-active{% endif %}" data-panel="email">
                    <h2 class="settings-panel-title">E-Mail</h2>
                    <p class="settings-panel-lead">Absender, Betreff und Text für Bestätigungsmails. Platzhalter werden beim Versand ersetzt.</p>

                    <div class="settings-block">
                        <div class="mb-3">
                            <label class="form-label" for="mail_from">Absender-Adresse</label>
                            <input class="form-control" type="email" name="mail_from" id="mail_from" value="{{ settings.mail_from|default('') }}">
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="mail_from_name">Absender-Name</label>
                            <input class="form-control" type="text" name="mail_from_name" id="mail_from_name" value="{{ settings.mail_from_name|default('') }}">
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="mail_subject">Betreff</label>
                            <input class="form-control" type="text" name="mail_subject" id="mail_subject" value="{{ settings.mail_subject|default('') }}">
                            <div class="form-text">Platzhalter möglich, z.&nbsp;B. <code>{name}</code>, <code>{fachbereich}</code>.</div>
                        </div>
                        <div class="mb-0">
                            <label class="form-label" for="mail_body">Mail-Text</label>
                            <textarea class="form-control rich-editor" name="mail_body" id="mail_body" rows="14">{{ settings.mail_body|default(mail_body_default, true) }}</textarea>
                            <div class="form-text mt-2">
                                Formatierung wie auf der Website. Platzhalter:
                                <code>{logo}</code>
                                (Logo aus Darstellung),
                                <code>{name}</code>,
                                <code>{email}</code>,
                                <code>{fachbereich}</code>,
                                <code>{schiene}</code>,
                                <code>{cancel_url}</code>,
                                <code>{thanks_url}</code>,
                                <code>{from_name}</code>
                                — <code>{logo}</code> an die gewünschte Stelle im Text setzen;
                                für Links z.&nbsp;B. URL <code>{cancel_url}</code> einfügen.
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">Speichern</button>
                </div>

                <div class="settings-panel{% if tab == 'rechtliches' %} is-active{% endif %}" data-panel="rechtliches">
                    <h2 class="settings-panel-title">Rechtliches</h2>
                    <p class="settings-panel-lead">Entweder externe URL oder eigenen Text hinterlegen. Eine URL hat Vorrang.</p>

                    <div class="settings-block">
                        <h3 class="settings-block-title">Impressum</h3>
                        <div class="mb-3">
                            <label class="form-label" for="impressum_url">Externe URL</label>
                            <input class="form-control" type="url" name="impressum_url" id="impressum_url" placeholder="https://…" value="{{ settings.impressum_url|default('') }}">
                        </div>
                        <div class="mb-0">
                            <label class="form-label" for="impressum_text">Oder Text</label>
                            <textarea class="form-control rich-editor" name="impressum_text" id="impressum_text" rows="5">{{ settings.impressum_text|default('') }}</textarea>
                        </div>
                    </div>

                    <div class="settings-block">
                        <h3 class="settings-block-title">Datenschutz</h3>
                        <div class="mb-3">
                            <label class="form-label" for="datenschutz_url">Externe URL</label>
                            <input class="form-control" type="url" name="datenschutz_url" id="datenschutz_url" placeholder="https://…" value="{{ settings.datenschutz_url|default('') }}">
                        </div>
                        <div class="mb-0">
                            <label class="form-label" for="datenschutz_text">Oder Text</label>
                            <textarea class="form-control rich-editor" name="datenschutz_text" id="datenschutz_text" rows="5">{{ settings.datenschutz_text|default('') }}</textarea>
                        </div>
                    </div>

                    <div class="settings-block">
                        <h3 class="settings-block-title">Woher kommt diese Seite</h3>
                        <p class="text-muted small mb-3">Erscheint als zusätzlicher Link im Fußbereich, z.&nbsp;B. für einen Hinweis auf die AG oder ein Dankeschön.</p>
                        <div class="mb-3">
                            <label class="form-label" for="about_link_label">Linkname</label>
                            <input class="form-control" type="text" name="about_link_label" id="about_link_label" maxlength="80"
                                   placeholder="Woher kommt diese Seite"
                                   value="{{ settings.about_link_label|default('Woher kommt diese Seite') }}">
                            <div class="form-text">Text des Links im Footer und Überschrift der Seite.</div>
                        </div>
                        <div class="mb-0">
                            <label class="form-label" for="about_text">Freitext</label>
                            <textarea class="form-control rich-editor" name="about_text" id="about_text" rows="5">{{ settings.about_text|default('') }}</textarea>
                            <div class="form-text">Leer lassen = Link wird nicht angezeigt.</div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">Speichern</button>
                </div>
            </form>

            {# —— Benutzer —— #}
            <div class="settings-panel{% if tab == 'benutzer' %} is-active{% endif %}" data-panel="benutzer">
                <h2 class="settings-panel-title">Benutzer</h2>
                <p class="settings-panel-lead">Administratoren mit vollem Zugriff oder Nutzer, die nur einen Fachbereich sehen.</p>

                <div class="settings-block">
                    <h3 class="settings-block-title">Vorhandene Benutzer</h3>
                    {% if users is empty %}
                        <p class="mb-0 text-muted">Keine Benutzer vorhanden.</p>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Benutzername</th>
                                        <th>Rolle</th>
                                        <th>Fachbereich</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                {% for u in users %}
                                    <tr>
                                        <td>{{ u.username }}{% if u.id == current_admin_id %} <span class="text-muted">(Sie)</span>{% endif %}</td>
                                        <td>{% if u.role == 'fachbereich' %}Fachbereich{% else %}Administrator{% endif %}</td>
                                        <td>{{ u.fachbereich_name|default('—') }}</td>
                                        <td class="text-end">
                                            {% if u.id != current_admin_id %}
                                                <form method="post" action="/administrator/einstellungen/benutzer/{{ u.id }}/delete" class="d-inline" onsubmit="return confirm('Benutzer „{{ u.username }}“ wirklich löschen?');">
                                                    {{ csrf.field()|raw }}
                                                    <button type="submit" class="btn btn-link btn-sm text-danger p-0">Löschen</button>
                                                </form>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>

                <div class="settings-block">
                    <h3 class="settings-block-title">Neuen Benutzer anlegen</h3>
                    <form method="post" action="/administrator/einstellungen/benutzer" id="user-create-form">
                        {{ csrf.field()|raw }}
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="username">Benutzername</label>
                                <input class="form-control" type="text" name="username" id="username" required maxlength="100" autocomplete="off">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="password">Passwort</label>
                                <input class="form-control" type="password" name="password" id="password" required minlength="8" autocomplete="new-password">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="role">Rolle</label>
                                <select class="form-select" name="role" id="role">
                                    <option value="admin">Administrator (voller Zugriff)</option>
                                    <option value="fachbereich">Fachbereich-Nutzer</option>
                                </select>
                            </div>
                            <div class="col-md-6" id="fachbereich-field" hidden>
                                <label class="form-label" for="fachbereich_id">Fachbereich</label>
                                <select class="form-select" name="fachbereich_id" id="fachbereich_id">
                                    <option value="">— bitte wählen —</option>
                                    {% for fb in fachbereiche %}
                                        <option value="{{ fb.id }}">{{ fb.name }}</option>
                                    {% endfor %}
                                </select>
                                {% if fachbereiche is empty %}
                                    <p class="form-text text-warning mb-0">Zuerst einen Fachbereich anlegen.</p>
                                {% endif %}
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">Benutzer anlegen</button>
                    </form>
                </div>
            </div>

            {# —— Update —— #}
            <div class="settings-panel{% if tab == 'update' %} is-active{% endif %}" data-panel="update">
                <h2 class="settings-panel-title">Update</h2>
                <p class="settings-panel-lead">Quelle einmal eintragen – sie wird dauerhaft gespeichert. Prüfen und Aktualisieren speichern die Quelle automatisch mit.</p>

                {% set u = update_status|default({
                    repo_url: settings.update_repo_url|default(''),
                    ref: settings.update_ref|default('main'),
                    current: '—',
                    remote: null,
                    up_to_date: null,
                    configured: false,
                    check_at: ''
                }) %}
                {% set update_repo_value = u.repo_url|default(settings.update_repo_url|default(''), true) %}
                {% if update_repo_value == '' %}
                    {% set update_repo_value = 'https://github.com/iAmCriptic/Grundschultag-Anmeldung' %}
                {% endif %}

                <form method="post" action="/administrator/einstellungen/update-quelle" id="update-source-form">
                    {{ csrf.field()|raw }}

                    <div class="settings-block">
                        <h3 class="settings-block-title">Update-Quelle</h3>
                        <p class="text-muted small mb-3">Wird in den Einstellungen gespeichert und beim nächsten Besuch wiederverwendet.</p>
                        <div class="mb-3">
                            <label class="form-label" for="update_repo_url">GitHub-Repository</label>
                            <input class="form-control" type="url" name="update_repo_url" id="update_repo_url" required
                                   placeholder="https://github.com/iAmCriptic/Grundschultag-Anmeldung"
                                   value="{{ update_repo_value }}">
                            <div class="form-text">Öffentliches Repo, z.&nbsp;B. <code>https://github.com/iAmCriptic/Grundschultag-Anmeldung</code></div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="update_ref">Branch oder Tag</label>
                            <input class="form-control" type="text" name="update_ref" id="update_ref" required
                                   placeholder="main" value="{{ u.ref|default('main') }}" maxlength="100" pattern="[A-Za-z0-9._/\-]+">
                        </div>
                        <button type="submit" class="btn btn-outline-secondary">Nur Quelle speichern</button>
                    </div>

                    <div class="settings-block">
                        <h3 class="settings-block-title">Status</h3>
                        {% if not u.configured %}
                            <p class="mb-0 text-muted">Noch nicht geprüft – Quelle wird beim ersten Prüfen oder Aktualisieren gespeichert.</p>
                        {% else %}
                            <dl class="row mb-0">
                                <dt class="col-sm-4">Gespeicherte Quelle</dt>
                                <dd class="col-sm-8"><code>{{ u.repo_url }}</code> @ <code>{{ u.ref }}</code></dd>
                                <dt class="col-sm-4">Installierte Version</dt>
                                <dd class="col-sm-8"><code>{{ u.current }}</code></dd>
                                <dt class="col-sm-4">Remote-Version</dt>
                                <dd class="col-sm-8">
                                    {% if u.remote %}
                                        <code>{{ u.remote }}</code>
                                        {% if u.up_to_date %}
                                            <span class="text-success ms-2">aktuell</span>
                                        {% else %}
                                            <span class="text-warning ms-2">Update verfügbar</span>
                                        {% endif %}
                                    {% else %}
                                        <span class="text-muted">noch nicht geprüft</span>
                                    {% endif %}
                                </dd>
                                {% if u.check_at %}
                                    <dt class="col-sm-4">Letzte Prüfung</dt>
                                    <dd class="col-sm-8">{{ u.check_at }}</dd>
                                {% endif %}
                                {% if settings.update_last_at|default('') %}
                                    <dt class="col-sm-4">Letztes Update</dt>
                                    <dd class="col-sm-8">{{ settings.update_last_at }}{% if settings.update_last_version|default('') %} ({{ settings.update_last_version }}){% endif %}</dd>
                                {% endif %}
                            </dl>
                        {% endif %}
                    </div>

                    <div class="settings-block">
                        <h3 class="settings-block-title">Aktualisieren</h3>
                        <p class="text-muted small mb-3">
                            Speichert die Quelle oben und nutzt sie für Prüfung bzw. Update.
                            Erhalten bleiben: <code>.env</code>, <code>vendor/</code>, <code>public/uploads/</code> und <code>storage/</code>.
                        </p>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-outline-primary"
                                    formaction="/administrator/einstellungen/update-check">
                                Jetzt prüfen
                            </button>
                            <button type="submit" class="btn btn-primary"
                                    formaction="/administrator/einstellungen/update"
                                    formmethod="post"
                                    onclick="return confirm('System jetzt aus dem GitHub-Repository aktualisieren?');">
                                Jetzt aktualisieren
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            {# —— Daten —— #}
            <div class="settings-panel{% if tab == 'daten' %} is-active{% endif %}" data-panel="daten">
                <h2 class="settings-panel-title">Daten löschen</h2>
                <p class="settings-panel-lead">Entfernt alle Anmeldungen unwiderruflich. Fachbereiche, Benutzer und Einstellungen bleiben erhalten.</p>

                <div class="settings-danger">
                    <p class="mb-2"><strong>{{ anmeldungen_total }}</strong> Anmeldung{{ anmeldungen_total != 1 ? 'en' : '' }} in der Datenbank.</p>
                    <form method="post" action="/administrator/einstellungen/daten-loeschen" onsubmit="return confirm('Wirklich alle Anmeldungen unwiderruflich löschen?');">
                        {{ csrf.field()|raw }}
                        <div class="mb-3">
                            <label class="form-label" for="confirm">Zur Bestätigung <code>LÖSCHEN</code> eingeben</label>
                            <input class="form-control" type="text" name="confirm" id="confirm" autocomplete="off" required placeholder="LÖSCHEN">
                        </div>
                        <button type="submit" class="btn btn-danger" {% if anmeldungen_total == 0 %}disabled{% endif %}>Alle Anmeldungen löschen</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block scripts %}
{% include 'partials/rich_editor_assets.twig' %}
<script>
(function () {
    var navItems = document.querySelectorAll('[data-settings-tab]');
    var panels = document.querySelectorAll('[data-panel]');
    var activeTabInput = document.getElementById('active_tab');
    var roleSelect = document.getElementById('role');
    var fbField = document.getElementById('fachbereich-field');
    var fbSelect = document.getElementById('fachbereich_id');

    function showTab(name) {
        navItems.forEach(function (btn) {
            btn.classList.toggle('is-active', btn.getAttribute('data-settings-tab') === name);
        });
        panels.forEach(function (panel) {
            panel.classList.toggle('is-active', panel.getAttribute('data-panel') === name);
        });
        if (activeTabInput) {
            activeTabInput.value = name;
        }
        if (history.replaceState) {
            var url = new URL(window.location.href);
            url.searchParams.set('tab', name);
            history.replaceState(null, '', url.toString());
        }
        if (window.AppRichEditor) {
            window.setTimeout(window.AppRichEditor.refresh, 50);
        }
    }

    navItems.forEach(function (btn) {
        btn.addEventListener('click', function () {
            showTab(btn.getAttribute('data-settings-tab'));
        });
    });

    function syncRole() {
        if (!roleSelect || !fbField) return;
        var isFb = roleSelect.value === 'fachbereich';
        fbField.hidden = !isFb;
        if (fbSelect) {
            fbSelect.required = isFb;
            if (!isFb) fbSelect.value = '';
        }
    }

    if (roleSelect) {
        roleSelect.addEventListener('change', syncRole);
        syncRole();
    }
})();
</script>
{% endblock %}
