{% extends 'layouts/admin.twig' %}
{% block title %}Übersicht{% endblock %}
{% block content %}
<section class="card app-card">
    <div class="card-body p-4">
        <h1 class="h2 mb-3">Übersicht</h1>
        {% if flash %}<div class="alert alert-info">{{ flash }}</div>{% endif %}
        {% if update_notice %}
            <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div>
                    <strong>Update verfügbar:</strong>
                    Version <code>{{ update_notice.current }}</code> → <code>{{ update_notice.remote }}</code>
                </div>
                <a class="btn btn-sm btn-warning" href="/administrator/einstellungen?tab=update">Zum Update</a>
            </div>
        {% endif %}
        <p>Angemeldet als <strong>{{ admin_username }}</strong>. Aktive Anmeldungen: <strong>{{ active_count }}</strong></p>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <a class="btn btn-outline-primary w-100 py-3" href="/administrator/fachbereiche">Fachbereiche verwalten</a>
            </div>
            <div class="col-md-4">
                <a class="btn btn-outline-primary w-100 py-3" href="/administrator/listen">Listen herunterladen</a>
            </div>
            {% if admin_is_full %}
            <div class="col-md-4">
                <a class="btn btn-outline-primary w-100 py-3" href="/administrator/einstellungen">Einstellungen</a>
            </div>
            {% endif %}
        </div>

        <h2 class="h4">Belegung</h2>
        {% if fachbereiche is empty %}
            <p class="mb-0">Noch keine Fachbereiche angelegt.</p>
        {% else %}
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr><th>Fachbereich</th><th>Status</th><th>Schienen</th></tr>
                    </thead>
                    <tbody>
                    {% for fb in fachbereiche %}
                        <tr>
                            <td><a href="/administrator/fachbereiche/{{ fb.id }}">{{ fb.name }}</a></td>
                            <td>{% if fb.aktiv %}aktiv{% else %}inaktiv{% endif %}</td>
                            <td>
                                {% for s in fb.schienen %}
                                    {{ s.name }}: {{ s.belegt }}/{{ s.kapazitaet }}{% if not loop.last %}; {% endif %}
                                {% else %}
                                    —
                                {% endfor %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
