<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ app_name }}{% endblock %}</title>
    {% if site_logo %}
        <link rel="icon" href="/uploads/{{ site_logo }}" type="image/png">
        <link rel="apple-touch-icon" href="/uploads/{{ site_logo }}">
    {% endif %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="/assets/css/app.css">
    {% block head %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
    <header class="site-header border-bottom bg-white">
        <div class="container site-header-inner">
            {% if site_logo %}
                <a class="site-logo-link" href="/">
                    <img class="site-logo" src="/uploads/{{ site_logo }}" alt="{{ app_name }}">
                </a>
            {% endif %}
            <a class="brand text-decoration-none fw-bold ms-auto" href="/">{{ app_name }}</a>
        </div>
    </header>
    <main class="container py-4">
        {% block content %}{% endblock %}
    </main>
    <footer class="site-footer py-4 text-muted">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>{{ app_name }}</span>
            <nav class="legal-links" aria-label="Rechtliches">
                {% if impressum_href %}
                    <a href="{{ impressum_href }}"{% if impressum_external %} target="_blank" rel="noopener noreferrer"{% endif %}>Impressum</a>
                {% endif %}
                {% if impressum_href and datenschutz_href %}<span class="legal-sep" aria-hidden="true">·</span>{% endif %}
                {% if datenschutz_href %}
                    <a href="{{ datenschutz_href }}"{% if datenschutz_external %} target="_blank" rel="noopener noreferrer"{% endif %}>Datenschutz</a>
                {% endif %}
                {% if about_href %}
                    {% if impressum_href or datenschutz_href %}<span class="legal-sep" aria-hidden="true">·</span>{% endif %}
                    <a href="{{ about_href }}">{{ about_link_label|default('Woher kommt diese Seite') }}</a>
                {% endif %}
                {% if impressum_href or datenschutz_href or about_href %}<span class="legal-sep" aria-hidden="true">·</span>{% endif %}
                <a href="#" data-cookie-settings>Cookie-Einstellungen</a>
            </nav>
        </div>
        <div class="container mt-3 text-center">
            <a href="https://www.sitelock.com/verify.php?site=merian.online" target="SiteLock" rel="noopener noreferrer"
               onclick="window.open(this.href,'SiteLock','width=600,height=600,left=160,top=170'); return false;">
                <img class="img-fluid" alt="SiteLock" title="SiteLock" src="https://shield.sitelock.com/shield/merian.online" width="128" height="65">
            </a>
        </div>
    </footer>

    <div id="cookie-consent" class="cookie-consent no-print" role="dialog" aria-labelledby="cookie-consent-title" aria-modal="false" hidden>
        <div class="cookie-consent-inner">
            <h2 id="cookie-consent-title" class="h6 mb-2">Cookie-Einstellungen</h2>
            <p class="small mb-3">
                Wir verwenden notwendige Cookies für den Betrieb der Website (z.&nbsp;B. Sitzung und Sicherheit).
                Optionale Cookies setzen wir nur mit Ihrer Einwilligung.
                {% if datenschutz_href %}
                    Mehr dazu in der
                    <a href="{{ datenschutz_href }}"{% if datenschutz_external %} target="_blank" rel="noopener noreferrer"{% endif %}>Datenschutzerklärung</a>.
                {% endif %}
            </p>
            <div class="cookie-categories mb-3">
                <label class="cookie-category">
                    <input type="checkbox" checked disabled>
                    <span>
                        <strong>Notwendig</strong>
                        <span class="d-block small text-muted">Erforderlich für Anmeldung und Sicherheit.</span>
                    </span>
                </label>
                <label class="cookie-category">
                    <input type="checkbox" id="cookie-statistics">
                    <span>
                        <strong>Statistik</strong>
                        <span class="d-block small text-muted">Hilft uns, die Nutzung anonym auszuwerten.</span>
                    </span>
                </label>
                <label class="cookie-category">
                    <input type="checkbox" id="cookie-marketing">
                    <span>
                        <strong>Marketing</strong>
                        <span class="d-block small text-muted">Für personalisierte Inhalte und Angebote.</span>
                    </span>
                </label>
            </div>
            <div class="cookie-actions">
                <button type="button" class="btn btn-primary btn-sm" id="cookie-accept-all">Alle akzeptieren</button>
                <button type="button" class="btn btn-outline-primary btn-sm" id="cookie-save">Auswahl speichern</button>
                <button type="button" class="btn btn-link btn-sm" id="cookie-necessary-only">Nur notwendige</button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="/assets/js/cookie-consent.js" defer></script>
    {% block scripts %}{% endblock %}
</body>
</html>
