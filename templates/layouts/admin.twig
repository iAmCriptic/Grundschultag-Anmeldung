<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Administration{% endblock %} · {{ app_name }}</title>
    <link rel="stylesheet" href="/assets/css/app.css">
</head>
<body class="admin-body">
    <header class="admin-header">
        <div class="wrap admin-header-inner">
            <a class="brand" href="/administrator">Admin</a>
            <nav class="admin-nav">
                <a href="/administrator">Übersicht</a>
                <a href="/administrator/fachbereiche">Fachbereiche</a>
                <a href="/administrator/listen">Listen</a>
                <a href="/administrator/einstellungen">Einstellungen</a>
                <a href="/" target="_blank" rel="noopener">Zur Website</a>
                <form method="post" action="/administrator/logout" class="inline-form">
                    {{ csrf.field()|raw }}
                    <button type="submit" class="linkish">Logout</button>
                </form>
            </nav>
        </div>
    </header>
    <main class="wrap">
        {% block content %}{% endblock %}
    </main>
</body>
</html>
