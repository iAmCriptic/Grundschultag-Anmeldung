{% extends 'layouts/base.twig' %}
{% block title %}Fachbereich wählen · {{ app_name }}{% endblock %}
{% block content %}
<section class="card app-card">
    <div class="card-body p-4">
        <h1 class="h2 mb-2">Fachbereich wählen</h1>
        <p class="text-muted mb-4">Wählen Sie den Fachbereich, für den Sie sich anmelden möchten.</p>

        {% if admin_test_mode|default(false) %}
            <div class="alert alert-info">Testmodus: Die öffentliche Anmeldung ist geschlossen. Als Administrator können Sie den Ablauf trotzdem prüfen.</div>
        {% endif %}

        {% if flash|default('') %}
            <div class="alert alert-warning">{{ flash }}</div>
        {% endif %}

        {% if fachbereiche is empty %}
            <div class="alert alert-warning">Derzeit sind keine Fachbereiche freigeschaltet.</div>
            <p class="mb-0"><a class="btn btn-outline-primary" href="/">Zurück</a></p>
        {% else %}
            <ul class="fb-pick-list">
                {% for fb in fachbereiche %}
                    <li>
                        <a class="fb-pick-item{% if fb.frei_total <= 0 %} is-full{% endif %}" href="/anmelden/{{ fb.id }}">
                            <div class="fb-pick-media">
                                {% if fb.teaser_bild %}
                                    <img src="/uploads/{{ fb.teaser_bild }}" alt="">
                                {% else %}
                                    <span class="fb-pick-placeholder" aria-hidden="true">{{ fb.name|slice(0, 1)|upper }}</span>
                                {% endif %}
                            </div>
                            <div class="fb-pick-body">
                                <h2 class="fb-pick-title">{{ fb.name }}</h2>
                                {% if fb.teaser_text %}
                                    <p class="fb-pick-excerpt">{{ fb.teaser_text|striptags|trim|slice(0, 140) }}{% if fb.teaser_text|striptags|trim|length > 140 %}…{% endif %}</p>
                                {% endif %}
                                <p class="fb-pick-meta">
                                    {% if fb.frei_total <= 0 %}
                                        Ausgebucht
                                    {% else %}
                                        {{ fb.frei_total }} von {{ fb.kap_total }} Plätzen frei
                                    {% endif %}
                                </p>
                            </div>
                            <span class="fb-pick-arrow" aria-hidden="true">→</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
            <p class="mt-4 mb-0"><a href="/">Abbrechen</a></p>
        {% endif %}
    </div>
</section>
{% endblock %}
