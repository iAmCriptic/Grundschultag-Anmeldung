{% extends 'layouts/base.twig' %}
{% block title %}Anmelden · {{ app_name }}{% endblock %}
{% block content %}
<section class="card app-card">
    <div class="card-body p-4">
        <h1 class="h2 mb-3">Anmeldung</h1>
        <p>Wählen Sie einen Fachbereich und eine Schiene und geben Sie Ihre Kontaktdaten an.</p>

        {% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}

        {% if fachbereiche is empty %}
            <div class="alert alert-warning">Derzeit sind keine Fachbereiche freigeschaltet.</div>
            <p class="mb-0"><a class="btn btn-outline-primary" href="/">Zurück</a></p>
        {% else %}
        <form method="post" action="/anmelden" id="register-form">
            {{ csrf.field()|raw }}

            <div class="mb-3">
                <label class="form-label" for="fachbereich_id">Fachbereich</label>
                <select class="form-select" name="fachbereich_id" id="fachbereich_id" required>
                    <option value="">Bitte wählen…</option>
                    {% for fb in fachbereiche %}
                        <option value="{{ fb.id }}"
                            {% if selected_fb == fb.id or old.fachbereich_id|default(0) == fb.id %}selected{% endif %}>
                            {{ fb.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div id="teaser" class="card bg-light mb-3" hidden>
                <div class="card-body">
                    <div class="teaser-media mb-2" id="teaser-media"></div>
                    <div class="teaser-text" id="teaser-text"></div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="schiene_id">Schiene</label>
                <select class="form-select" name="schiene_id" id="schiene_id" required>
                    <option value="">Zuerst Fachbereich wählen…</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label" for="name">Name</label>
                <input class="form-control" type="text" name="name" id="name" required value="{{ old.name|default('') }}">
            </div>
            <div class="mb-3">
                <label class="form-label" for="email">E-Mail</label>
                <input class="form-control" type="email" name="email" id="email" required value="{{ old.email|default('') }}">
            </div>

            <button type="submit" class="btn btn-primary">Anmeldung absenden</button>
            <p class="mt-3 mb-0"><a href="/">Abbrechen</a></p>
        </form>
        {% endif %}
    </div>
</section>
{% endblock %}

{% block scripts %}
<script>
const fachbereiche = {{ fachbereiche|json_encode|raw }};
const oldSchiene = {{ old.schiene_id|default(0)|json_encode|raw }};
const fbSelect = document.getElementById('fachbereich_id');
const schieneSelect = document.getElementById('schiene_id');
const teaser = document.getElementById('teaser');
const teaserMedia = document.getElementById('teaser-media');
const teaserText = document.getElementById('teaser-text');

function render() {
    const id = parseInt(fbSelect.value || '0', 10);
    const fb = fachbereiche.find(f => parseInt(f.id, 10) === id);
    schieneSelect.innerHTML = '';
    if (!fb) {
        teaser.hidden = true;
        schieneSelect.innerHTML = '<option value="">Zuerst Fachbereich wählen…</option>';
        return;
    }
    teaser.hidden = false;
    teaserText.innerHTML = (fb.teaser_text || '').replace(/\n/g, '<br>');
    teaserMedia.innerHTML = fb.teaser_bild
        ? '<img src="/uploads/' + fb.teaser_bild + '" alt="">'
        : '';
    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = 'Bitte Schiene wählen…';
    schieneSelect.appendChild(placeholder);
    (fb.schienen || []).forEach(s => {
        const frei = Math.max(0, parseInt(s.kapazitaet, 10) - parseInt(s.belegt || 0, 10));
        const opt = document.createElement('option');
        opt.value = s.id;
        opt.textContent = s.name + ' (' + frei + ' frei von ' + s.kapazitaet + ')';
        if (frei <= 0) {
            opt.disabled = true;
            opt.textContent = s.name + ' (ausgebucht)';
        }
        if (parseInt(oldSchiene, 10) === parseInt(s.id, 10)) opt.selected = true;
        schieneSelect.appendChild(opt);
    });
}
fbSelect.addEventListener('change', render);
render();
</script>
{% endblock %}
