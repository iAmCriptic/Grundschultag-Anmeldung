{% extends 'layouts/base.twig' %}
{% block title %}Anmeldung · {{ fachbereich.name }} · {{ app_name }}{% endblock %}
{% block content %}
<section class="card app-card overflow-hidden">
    {% if fachbereich.teaser_bild %}
        <div class="teaser-media teaser-media-hero">
            <img src="/uploads/{{ fachbereich.teaser_bild }}" alt="">
        </div>
    {% endif %}
    <div class="card-body p-4">
        <p class="mb-2"><a class="text-decoration-none" href="/anmelden">← Alle Fachbereiche</a></p>
        <h1 class="h2 mb-3">{{ fachbereich.name }}</h1>

        {% if fachbereich.teaser_text %}
            <div class="mb-4 rich-content">{{ fachbereich.teaser_text|rich }}</div>
        {% endif %}

        {% if admin_test_mode|default(false) %}
            <div class="alert alert-info">Testmodus: Die öffentliche Anmeldung ist geschlossen. Als Administrator können Sie den Ablauf trotzdem prüfen.</div>
        {% endif %}

        {% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}

        {% if fachbereich.schienen is empty %}
            <div class="alert alert-warning">Für diesen Fachbereich sind derzeit keine Schienen verfügbar.</div>
            <p class="mb-0"><a class="btn btn-outline-primary" href="/anmelden">Zurück zur Übersicht</a></p>
        {% else %}
            <form method="post" action="/anmelden/{{ fachbereich.id }}" id="register-form">
                {{ csrf.field()|raw }}

                <div class="mb-3">
                    <label class="form-label" for="schiene_id">Schiene</label>
                    <select class="form-select" name="schiene_id" id="schiene_id" required>
                        <option value="">Bitte Schiene wählen…</option>
                        {% for s in fachbereich.schienen %}
                            <option value="{{ s.id }}"
                                {% if old.schiene_id|default(0) == s.id %}selected{% endif %}
                                {% if s.frei <= 0 %}disabled{% endif %}>
                                {% if s.frei <= 0 %}
                                    {{ s.name }} (ausgebucht)
                                {% else %}
                                    {{ s.name }} ({{ s.frei }} frei von {{ s.kapazitaet }})
                                {% endif %}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="name">Vor &amp; Nachname</label>
                    <input class="form-control" type="text" name="name" id="name" required value="{{ old.name|default('') }}">
                </div>
                <div class="mb-3">
                    <label class="form-label" for="email">E-Mail</label>
                    <input class="form-control" type="email" name="email" id="email" required value="{{ old.email|default('') }}">
                </div>

                <button type="submit" class="btn btn-primary">Anmeldung absenden</button>
                <p class="mt-3 mb-0"><a href="/anmelden">Abbrechen</a></p>
            </form>
        {% endif %}
    </div>
</section>
{% endblock %}
