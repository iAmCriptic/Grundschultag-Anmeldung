{% extends 'layouts/base.twig' %}
{% block title %}Willkommen · {{ app_name }}{% endblock %}
{% block body_class %}page-home{% endblock %}
{% block content %}
<section class="card app-card overflow-hidden">
    {% if welcome_image %}
        <div class="hero-media">
            <img src="/uploads/{{ welcome_image }}" alt="" class="card-img-top">
        </div>
    {% endif %}
    <div class="card-body p-4">
        <h1 class="h2 mb-3">{{ app_name }}</h1>
        <div class="mb-3">{{ welcome_text|nl2br }}</div>
        {% if open %}
            <p class="mb-0"><a class="btn btn-primary btn-lg" href="/anmelden">Anmelden</a></p>
        {% else %}
            <div class="alert alert-warning">Die Anmeldung ist derzeit geschlossen.</div>
            {% if registration_start or registration_end %}
                <p class="text-muted mb-0">
                    {% if registration_start %}Von {{ registration_start|replace({'T': ' '}) }}{% endif %}
                    {% if registration_end %} bis {{ registration_end|replace({'T': ' '}) }}{% endif %}
                </p>
            {% endif %}
        {% endif %}
    </div>
</section>
{% endblock %}
