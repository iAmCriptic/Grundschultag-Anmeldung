{% extends 'layouts/base.twig' %}
{% block title %}Bestätigung · {{ app_name }}{% endblock %}
{% block body_class %}page-confirmation{% endblock %}
{% block content %}
<section class="card app-card">
    <div class="card-body p-4">
        {% if site_logo %}
            <div class="confirmation-logo">
                <img src="/uploads/{{ site_logo }}" alt="{{ app_name }}">
            </div>
        {% endif %}
        <h1 class="h2 mb-3">Danke für Ihre Anmeldung</h1>
        {% if anmeldung.status == 'storniert' %}
            <div class="alert alert-warning">Diese Anmeldung wurde storniert.</div>
        {% else %}
            <p>Ihre Anmeldung ist gespeichert. Eine Bestätigung wurde per E-Mail versendet.</p>
        {% endif %}

        <dl class="detail-list mb-4">
            <dt>Vor &amp; Nachname</dt><dd>{{ anmeldung.name }}</dd>
            <dt>E-Mail</dt><dd>{{ anmeldung.email }}</dd>
            <dt>Fachbereich</dt><dd>{{ anmeldung.fachbereich_name }}</dd>
            <dt>Schiene</dt><dd>{{ anmeldung.schiene_name }}</dd>
            <dt>Status</dt><dd>{{ anmeldung.status }}</dd>
        </dl>

        <div class="no-print d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-primary" onclick="window.print()">Bestätigung drucken / speichern</button>
            <a class="btn btn-outline-primary" href="/">Zur Startseite</a>
        </div>
    </div>
</section>
{% endblock %}
