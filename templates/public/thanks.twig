{% extends 'layouts/base.twig' %}
{% block title %}Bestätigung · {{ app_name }}{% endblock %}
{% block head %}
<style>
@media print {
    .site-header, .site-footer, .no-print { display: none !important; }
    body { background: #fff; color: #000; }
    .panel { box-shadow: none; border: none; }
}
</style>
{% endblock %}
{% block content %}
<section class="panel confirm-card">
    <h1>Danke für Ihre Anmeldung</h1>
    {% if anmeldung.status == 'storniert' %}
        <p class="flash">Diese Anmeldung wurde storniert.</p>
    {% else %}
        <p>Ihre Anmeldung ist gespeichert. Eine Bestätigung wurde per E-Mail versendet.</p>
    {% endif %}

    <dl class="detail-list">
        <dt>Name</dt><dd>{{ anmeldung.name }}</dd>
        <dt>E-Mail</dt><dd>{{ anmeldung.email }}</dd>
        <dt>Fachbereich</dt><dd>{{ anmeldung.fachbereich_name }}</dd>
        <dt>Schiene</dt><dd>{{ anmeldung.schiene_name }}</dd>
        <dt>Status</dt><dd>{{ anmeldung.status }}</dd>
    </dl>

    <div class="no-print actions">
        <button type="button" class="btn" onclick="window.print()">Bestätigung drucken / speichern</button>
        <a class="btn btn-secondary" href="/">Zur Startseite</a>
    </div>
</section>
{% endblock %}
