{% extends 'layouts/base.twig' %}
{% block title %}Stornierung · {{ app_name }}{% endblock %}
{% block content %}
<section class="panel">
    <h1>Anmeldung stornieren</h1>

    {% if done %}
        <p class="flash ok">Ihre Anmeldung wurde storniert.</p>
        <dl class="detail-list">
            <dt>Name</dt><dd>{{ anmeldung.name }}</dd>
            <dt>Fachbereich</dt><dd>{{ anmeldung.fachbereich_name }}</dd>
            <dt>Schiene</dt><dd>{{ anmeldung.schiene_name }}</dd>
        </dl>
        <p><a class="btn" href="/">Zur Startseite</a></p>
    {% elseif anmeldung.status == 'storniert' %}
        <p class="flash">Diese Anmeldung ist bereits storniert.</p>
        <p><a class="btn" href="/">Zur Startseite</a></p>
    {% else %}
        {% if error %}<p class="flash error">{{ error }}</p>{% endif %}
        <p>Möchten Sie die folgende Anmeldung wirklich stornieren?</p>
        <dl class="detail-list">
            <dt>Name</dt><dd>{{ anmeldung.name }}</dd>
            <dt>E-Mail</dt><dd>{{ anmeldung.email }}</dd>
            <dt>Fachbereich</dt><dd>{{ anmeldung.fachbereich_name }}</dd>
            <dt>Schiene</dt><dd>{{ anmeldung.schiene_name }}</dd>
        </dl>
        <form method="post" action="/stornieren/{{ anmeldung.token }}">
            {{ csrf.field()|raw }}
            <button type="submit" class="btn">Ja, stornieren</button>
            <a class="btn btn-secondary" href="/">Abbrechen</a>
        </form>
    {% endif %}
</section>
{% endblock %}
